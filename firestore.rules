rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // School Reports Collection
    match /school_reports/{reportId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(reportId) &&
        incoming().userId == request.auth.uid &&
        incoming().schoolName is string &&
        incoming().status is string;
      allow update: if isSignedIn() && isValidId(reportId) &&
        (isOwner(resource.data.userId) || incoming().userId == request.auth.uid);
      allow delete: if isSignedIn() && isValidId(reportId) && isOwner(resource.data.userId);
    }

    // Report Submissions Collection
    match /report_submissions/{submissionId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(submissionId) &&
        incoming().userId == request.auth.uid &&
        incoming().reportId is string &&
        incoming().schoolName is string &&
        incoming().status is string;
      allow update: if isSignedIn() && isValidId(submissionId) &&
        isOwner(resource.data.userId) &&
        incoming().userId == resource.data.userId;
      allow delete: if isSignedIn() && isValidId(submissionId) && isOwner(resource.data.userId);
    }

    // Report Save History / Version Audit Trail
    match /report_history/{historyId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(historyId) &&
        incoming().userId == request.auth.uid &&
        incoming().reportId is string;
      allow update: if isSignedIn() && isValidId(historyId) &&
        (isOwner(resource.data.userId) || incoming().userId == request.auth.uid);
      allow delete: if isSignedIn() && isValidId(historyId) && isOwner(resource.data.userId);
    }

    // Connection test document (safe read/write check)
    match /test/connection {
      allow read, write: if true;
    }
  }
}
